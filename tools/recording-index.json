 {
  "lang": "ar",
  "kid": "rafeef",
  "text": "اِسْتِطَاعَ العُلَمَاءُ تَفْسِيرَ ظَاهِرَةٍ غَامِضَةٍ.",
  "id": "ar_rec_31"
 },
 {
  "lang": "ar",
  "kid": "rafeef",
  "text": "إِنَّ المُثَابَرَةَ سَبِيلُ المُتَفَوِّقِينَ.",
  "id": "ar_rec_32"
 },
 {
  "lang": "ar",
  "kid": "rafeef",
  "text": "اِزْدَادَتْ مَسْؤُولِيَّاتُهُ بَعْدَ التَّخَرُّجِ.",
  "id": "ar_rec_33"
 },
 {
  "lang": "ar",
  "kid": "rafeef",
  "text": "لَا يَسْتَوِي الَّذِينَ يَعْلَمُونَ وَالَّذِينَ لَا يَعْلَمُونَ.",
  "id": "ar_rec_34"
 },
 {
  "lang": "ar",
  "kid": "rafeef",
  "text": "اِسْتَقْبَلَتِ المَدِينَةُ زُوَّارًا مِنْ شَتَّى البِلَادِ.",
  "id": "ar_rec_35"
 },
 {
  "lang": "ar",
  "kid": "rafeef",
  "text": "الاِخْتِرَاعُ ثَمَرَةُ سُؤَالٍ لَمْ يَجِدْ جَوَابًا.",
  "id": "ar_rec_36"
 },
 {
  "lang": "ar",
  "kid": "rafeef",
  "text": "تَحْتَاجُ البِيئَةُ إِلَى وَعْيٍ جَمَاعِيٍّ لَا فَرْدِيٍّ.",
  "id": "ar_rec_37"
 },
 {
  "lang": "ar",
  "kid": "rafeef",
  "text": "أَثْمَرَتْ تَجْرِبَتُهُ بَعْدَ سِنِينَ مِنَ الصَّبْرِ.",
  "id": "ar_rec_38"
 },
 {
  "lang": "ar",
  "kid": "rafeef",
  "text": "اِسْتَخْلَصَ البَاحِثُ نَتِيجَةً مُهِمَّةً.",
  "id": "ar_rec_39"
 },
 {
  "lang": "ar",
  "kid": "rafeef",
  "text": "مَنْ تَأَنَّى أَدْرَكَ مَا تَمَنَّى.",
  "id": "ar_rec_40"
 },
 {
  "lang": "ar",
  "kid": "hasan",
  "text": "اِسْتَنْبَطَ الفُقَهَاءُ أَحْكَامًا مِنَ النُّصُوصِ.",
  "id": "ar_rec_41"
 },
 {
  "lang": "ar",
  "kid": "hasan",
  "text": "لَا يُدْرِكُ المَجْدَ إِلَّا مَنْ صَبَرَ عَلَى مَرَارَتِهِ.",
  "id": "ar_rec_42"
 },
 {
  "lang": "ar",
  "kid": "hasan",
  "text": "تَتَجَلَّى عَظَمَةُ الأُمَمِ فِي إِنْجَازَاتِهَا العِلْمِيَّةِ.",
  "id": "ar_rec_43"
 },
 {
  "lang": "ar",
  "kid": "hasan",
  "text": "اِسْتَشْهَدَ البَاحِثُ بِمَرَاجِعَ مُتَعَدِّدَةٍ.",
  "id": "ar_rec_44"
 },
 {
  "lang": "ar",
  "kid": "hasan",
  "text": "إِنَّ الظَّوَاهِرَ الطَّبِيعِيَّةَ تَخْضَعُ لِقَوَانِينَ دَقِيقَةٍ.",
  "id": "ar_rec_45"
 },
 {
  "lang": "ar",
  "kid": "hasan",
  "text": "اِزْدَهَرَتِ الحَضَارَةُ الإِسْلَامِيَّةُ بِالتَّرْجَمَةِ وَالتَّأْلِيفِ.",
  "id": "ar_rec_46"
 },
 {
  "lang": "ar",
  "kid": "hasan",
  "text": "لَمْ يَكُنِ التَّقَدُّمُ وَلِيدَ صُدْفَةٍ بَلْ ثَمَرَةَ تَخْطِيطٍ.",
  "id": "ar_rec_47"
 },
 {
  "lang": "ar",
  "kid": "hasan",
  "text": "اِسْتَخْلَصَ الدَّارِسُونَ نَتَائِجَ مُتَبَايِنَةً.",
  "id": "ar_rec_48"
 },
 {
  "lang": "ar",
  "kid": "hasan",
  "text": "تَقْتَضِي الأَمَانَةُ العِلْمِيَّةُ نِسْبَةَ القَوْلِ إِلَى قَائِلِهِ.",
  "id": "ar_rec_49"
 },
 {
  "lang": "ar",
  "kid": "hasan",
  "text": "مَنِ اسْتَعْجَلَ الشَّيْءَ قَبْلَ أَوَانِهِ عُوقِبَ بِحِرْمَانِهِ.",
  "id": "ar_rec_50"
 },
