 {
  "lang": "en",
  "kid": "osama",
  "text": "The students visit the library every Sunday.",
  "id": "en_rec_19"
 },
 {
  "lang": "en",
  "kid": "osama",
  "text": "My father repairs the old car in the garage.",
  "id": "en_rec_20"
 },
 {
  "lang": "en",
  "kid": "osama",
  "text": "She always drinks a glass of milk before bed.",
  "id": "en_rec_21"
 },
 {
  "lang": "en",
  "kid": "osama",
  "text": "The teacher explained the lesson very clearly.",
  "id": "en_rec_22"
 },
 {
  "lang": "en",
  "kid": "osama",
  "text": "We planted five small trees in the school garden.",
  "id": "en_rec_23"
 },
 {
  "lang": "en",
  "kid": "osama",
  "text": "They are building a new bridge near the river.",
  "id": "en_rec_24"
 },
 {
  "lang": "en",
  "kid": "osama",
  "text": "He forgot his umbrella at his friend's house.",
  "id": "en_rec_25"
 },
 {
  "lang": "en",
  "kid": "osama",
  "text": "The museum opens at nine in the morning.",
  "id": "en_rec_26"
 },
 {
  "lang": "en",
  "kid": "osama",
  "text": "Our neighbours travelled to Egypt last winter.",
  "id": "en_rec_27"
 },
 {
  "lang": "en",
  "kid": "osama",
  "text": "I finished my homework before the sunset.",
  "id": "en_rec_28"
 },
 {
  "lang": "en",
  "kid": "rafeef",
  "text": "The library was crowded during the examination week.",
  "id": "en_rec_29"
 },
 {
  "lang": "en",
  "kid": "rafeef",
  "text": "She apologised for arriving late to the meeting.",
  "id": "en_rec_30"
 },
 {
  "lang": "en",
  "kid": "rafeef",
  "text": "Scientists believe the ocean holds many undiscovered species.",
  "id": "en_rec_31"
 },
 {
  "lang": "en",
  "kid": "rafeef",
  "text": "My cousin has been living in Jeddah since 2019.",
  "id": "en_rec_32"
 },
 {
  "lang": "en",
  "kid": "rafeef",
  "text": "The committee agreed to postpone the decision.",
  "id": "en_rec_33"
 },
 {
  "lang": "en",
  "kid": "rafeef",
  "text": "Reading regularly improves both writing and thinking.",
  "id": "en_rec_34"
 },
 {
  "lang": "en",
  "kid": "rafeef",
  "text": "He was surprised by the sudden change in weather.",
  "id": "en_rec_35"
 },
 {
  "lang": "en",
  "kid": "rafeef",
  "text": "They have already submitted their research project.",
  "id": "en_rec_36"
 },
 {
  "lang": "en",
  "kid": "rafeef",
  "text": "The government announced a new environmental plan.",
  "id": "en_rec_37"
 },
 {
  "lang": "en",
  "kid": "rafeef",
  "text": "Success usually follows years of quiet preparation.",
  "id": "en_rec_38"
 },
 {
  "lang": "en",
  "kid": "rafeef",
  "text": "Our teacher encouraged us to ask difficult questions.",
  "id": "en_rec_39"
 },
 {
  "lang": "en",
  "kid": "rafeef",
  "text": "The bridge was damaged during the heavy storm.",
  "id": "en_rec_40"
 },
 {
  "lang": "en",
  "kid": "rafeef",
  "text": "She prefers walking to school rather than taking the bus.",
  "id": "en_rec_41"
 },
 {
  "lang": "en",
  "kid": "rafeef",
  "text": "Many students struggle with time management.",
  "id": "en_rec_42"
 },
 {
  "lang": "en",
  "kid": "rafeef",
  "text": "The photograph reminded him of his childhood.",
  "id": "en_rec_43"
 },
 {
  "lang": "en",
  "kid": "hasan",
  "text": "The committee unanimously approved the proposed amendment.",
  "id": "en_rec_44"
 },
 {
  "lang": "en",
  "kid": "hasan",
  "text": "Researchers emphasised the significance of preliminary evidence.",
  "id": "en_rec_45"
 },
 {
  "lang": "en",
  "kid": "hasan",
  "text": "She had been studying abroad before the pandemic began.",
  "id": "en_rec_46"
 },
 {
  "lang": "en",
  "kid": "hasan",
  "text": "Had they consulted an expert, the outcome would have differed.",
  "id": "en_rec_47"
 },
 {
  "lang": "en",
  "kid": "hasan",
  "text": "The manuscript was translated into seventeen languages.",
  "id": "en_rec_48"
 },
 {
  "lang": "en",
  "kid": "hasan",
  "text": "Environmental degradation threatens future generations.",
  "id": "en_rec_49"
 },
 {
  "lang": "en",
  "kid": "hasan",
  "text": "His argument was persuasive although it lacked statistics.",
  "id": "en_rec_50"
 },
 {
  "lang": "en",
  "kid": "hasan",
  "text": "The archaeologist uncovered artefacts dating back centuries.",
  "id": "en_rec_51"
 },
 {
  "lang": "en",
  "kid": "hasan",
  "text": "Consistency matters more than occasional brilliance.",
  "id": "en_rec_52"
 },
 {
  "lang": "en",
  "kid": "hasan",
  "text": "Not only did he apologise, but he also corrected the error.",
  "id": "en_rec_53"
 },
 {
  "lang": "en",
  "kid": "hasan",
  "text": "The phenomenon remains largely unexplained by scientists.",
  "id": "en_rec_54"
 },
 {
  "lang": "en",
  "kid": "hasan",
  "text": "Several factors contributed to the unexpected decline.",
  "id": "en_rec_55"
 },
 {
  "lang": "en",
  "kid": "hasan",
  "text": "She was awarded a scholarship for her outstanding achievement.",
  "id": "en_rec_56"
 },
 {
  "lang": "en",
  "kid": "hasan",
  "text": "The negotiations concluded without a definitive agreement.",
  "id": "en_rec_57"
 },
 {
  "lang": "en",
  "kid": "hasan",
  "text": "Technology has fundamentally reshaped modern communication.",
  "id": "en_rec_58"
 }
]